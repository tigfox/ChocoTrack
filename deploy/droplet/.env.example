# Copy to /opt/chocotrack/.env and fill in. Never commit the real file.
# Public hostname that points at the Droplet (an A record, or <ip-with-dashes>.sslip.io for a first test).
APP_DOMAIN=chocotrack.example.com

# From the Dev Dashboard: ChocoTrack app -> Settings.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://chocotrack.example.com
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_inventory_transfers,write_inventory_transfers

# Written by deploy.sh; the image tag currently running.
IMAGE_TAG=latest
